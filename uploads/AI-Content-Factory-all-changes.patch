diff -ruN '--exclude=.git' '--exclude=__pycache__' orig/AI-Content-Factory-latest/backend/migrations/005_episodes_scenes_shots.sql AI-Content-Factory-latest/backend/migrations/005_episodes_scenes_shots.sql
