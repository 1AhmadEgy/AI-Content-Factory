# Backend
AICF_DATABASE_PATH=./data/factory.db
AICF_ASSET_ROOT=./data/assets
AICF_WORKER_ID=auto
AICF_WORKER_AUTOSTART=false
AICF_SCHEDULER_AUTOSTART=true
AICF_SCHEDULER_INTERVAL_SECONDS=5
AICF_FFMPEG_BIN=ffmpeg
AICF_FFPROBE_BIN=ffprobe
AICF_API_BASE_URL=http://10.0.2.2:8000/
AICF_API_TOKEN=
AICF_POSTGRES_DSN=

# Real AI provider
# Never commit the real key. Inject it through the server environment or GitHub Actions secret.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AICF_PROVIDER_TIMEOUT_SECONDS=120
# These must be set explicitly to model IDs supported by your configured provider/account.
AICF_TEXT_MODEL=
AICF_IMAGE_MODEL=
AICF_TTS_MODEL=
