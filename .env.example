# Backend
# SQLite remains the local/default store. Production PostgreSQL baseline is under backend/migrations/.
AICF_DATABASE_PATH=./data/factory.db
AICF_ASSET_ROOT=./data/assets
AICF_WORKER_ID=auto
AICF_WORKER_AUTOSTART=false
AICF_SCHEDULER_AUTOSTART=true
AICF_SCHEDULER_INTERVAL_SECONDS=5
AICF_FFMPEG_BIN=ffmpeg
AICF_FFPROBE_BIN=ffprobe
# Android/clients: full API origin, including trailing slash.
AICF_API_BASE_URL=http://10.0.2.2:8000/
# Set a strong value in production. When set, all API routes except /health and /ready require Bearer auth.
AICF_API_TOKEN=
# Reserved for the PostgreSQL deployment adapter; apply backend/migrations in order.
AICF_POSTGRES_DSN=

# Real AI provider endpoints
# Text endpoint must expose an OpenAI-compatible POST /v1/chat/completions API.
AICF_TEXT_PROVIDER_ENDPOINT=http://127.0.0.1:11434
AICF_TEXT_PROVIDER_MODEL=your-text-model
AICF_TEXT_PROVIDER_NAME=local-text
AICF_TEXT_PROVIDER_CAPABILITIES=story,script,scene,shot
AICF_TEXT_PROVIDER_TIMEOUT_SECONDS=120
AICF_TEXT_PROVIDER_PRIORITY=50

# Media endpoint must accept {model,parameters,seed} and return binary media or JSON with base64 data.
AICF_MEDIA_PROVIDER_ENDPOINT=http://127.0.0.1:9000/generate
AICF_MEDIA_PROVIDER_MODEL=your-media-model
AICF_MEDIA_PROVIDER_NAME=local-media
AICF_MEDIA_PROVIDER_CAPABILITIES=image,video,tts,music,sfx,lipsync,upscale,interpolation
AICF_MEDIA_PROVIDER_TIMEOUT_SECONDS=300
AICF_MEDIA_PROVIDER_PRIORITY=50

# No mock provider, fake success, timer-based completion, or silent provider fallback is configured.
