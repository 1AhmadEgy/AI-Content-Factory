# Backend
AICF_API_KEY=__NOT_CONFIGURED__
AICF_DATABASE_PATH=./data/factory.db
AICF_ASSET_ROOT=./data/assets
AICF_WORKER_ID=auto
AICF_WORKER_AUTOSTART=false
AICF_SCHEDULER_AUTOSTART=true
AICF_SCHEDULER_INTERVAL_SECONDS=5
AICF_FFMPEG_BIN=ffmpeg
AICF_FFPROBE_BIN=ffprobe
AICF_API_BASE_URL=http://10.0.2.2:8000/
AICF_POSTGRES_DSN=__NOT_CONFIGURED__

# Real AI providers
# Never commit real keys. Inject them through the server environment or GitHub Actions secrets.
AICF_PROVIDER_TIMEOUT_SECONDS=120

# OpenAI
OPENAI_API_KEY=__NOT_CONFIGURED__
OPENAI_BASE_URL=https://api.openai.com/v1
AICF_TEXT_MODEL=__NOT_CONFIGURED__
AICF_IMAGE_MODEL=__NOT_CONFIGURED__
AICF_TTS_MODEL=__NOT_CONFIGURED__

# Google Gemini
GEMINI_API_KEY=__NOT_CONFIGURED__
AICF_GEMINI_TEXT_MODEL=__NOT_CONFIGURED__

# Anthropic Claude
ANTHROPIC_API_KEY=__NOT_CONFIGURED__
AICF_ANTHROPIC_TEXT_MODEL=__NOT_CONFIGURED__

# DeepSeek
DEEPSEEK_API_KEY=__NOT_CONFIGURED__
AICF_DEEPSEEK_TEXT_MODEL=__NOT_CONFIGURED__
