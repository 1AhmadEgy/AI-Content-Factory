# Runtime
# development is the free local/default runtime. production fails closed until the PostgreSQL runtime is implemented.
AICF_ENV=development

# Backend
AICF_DATABASE_PATH=./data/factory.db
AICF_ASSET_ROOT=./data/assets
AICF_WORKER_ID=auto
AICF_WORKER_AUTOSTART=false
AICF_SCHEDULER_AUTOSTART=true
AICF_SCHEDULER_INTERVAL_SECONDS=5
AICF_FFMPEG_BIN=ffmpeg
AICF_FFPROBE_BIN=ffprobe
# Android/clients: full API origin, including trailing slash.
AICF_API_BASE_URL=http://10.0.2.2:8000/
# Optional local development bearer token. Set a strong value when exposing the API.
AICF_API_TOKEN=
# Reserved for the PostgreSQL runtime; production rejects startup until it is actually implemented.
AICF_DATABASE_URL=
AICF_POSTGRES_DSN=

# Real local text provider (optional).
# Endpoint must expose an OpenAI-compatible POST /v1/chat/completions API.
# For Docker + Ollama use http://ollama:11434 (docker-compose.free.yml does this automatically).
AICF_TEXT_PROVIDER_ENDPOINT=http://127.0.0.1:11434
AICF_TEXT_PROVIDER_MODEL=your-text-model
AICF_TEXT_PROVIDER_NAME=local-text
AICF_TEXT_PROVIDER_CAPABILITIES=story,script,scene,shot
AICF_TEXT_PROVIDER_TIMEOUT_SECONDS=120
AICF_TEXT_PROVIDER_PRIORITY=50

# Optional real Google Gemini Developer API text provider.
# Get the key from Google AI Studio. Leave blank to disable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_CAPABILITIES=story,script,scene,shot,character,world,text
GEMINI_TIMEOUT_SECONDS=120
GEMINI_PRIORITY=40

# Optional real Hugging Face Inference Providers text provider.
# HF routes requests to a supported provider/model; free accounts currently receive a small monthly credit.
HF_TOKEN=
HF_MODEL=
HF_ENDPOINT=https://router.huggingface.co
HF_CAPABILITIES=story,script,scene,shot,character,world,text
HF_TIMEOUT_SECONDS=120
HF_PRIORITY=60

# Real media provider (optional until a real local/cloud media endpoint is available).
# The endpoint must accept {model,parameters,seed} and return actual media bytes or JSON with base64 data.
AICF_MEDIA_PROVIDER_ENDPOINT=
AICF_MEDIA_PROVIDER_MODEL=
AICF_MEDIA_PROVIDER_NAME=local-media
AICF_MEDIA_PROVIDER_CAPABILITIES=image,video,tts,music,sfx,lipsync,upscale,interpolation
AICF_MEDIA_PROVIDER_TIMEOUT_SECONDS=300
AICF_MEDIA_PROVIDER_PRIORITY=50

# Never configure mock providers, fake success, timer-based completion, or silent provider fallback.
