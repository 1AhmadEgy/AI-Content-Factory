# Backend
AICF_DATABASE_PATH=./data/factory.db
AICF_ASSET_ROOT=./data/assets
AICF_WORKER_ID=auto
AICF_WORKER_AUTOSTART=false
AICF_SCHEDULER_AUTOSTART=true
AICF_SCHEDULER_INTERVAL_SECONDS=5
AICF_FFMPEG_BIN=ffmpeg
AICF_FFPROBE_BIN=ffprobe
# Production must use a real HTTPS API endpoint. Android cleartext traffic is disabled.
AICF_API_BASE_URL=https://api.example.invalid/
# Non-empty sentinel keeps Android BuildConfig generation valid without secrets.
AICF_API_TOKEN=__NOT_CONFIGURED__
AICF_POSTGRES_DSN=__NOT_CONFIGURED__

# Durable retry policy
AICF_RETRY_BASE_SECONDS=2
AICF_RETRY_MAX_SECONDS=300

# Real AI provider
# Never commit the real key. Inject it through the server environment or GitHub Actions secret.
OPENAI_API_KEY=__NOT_CONFIGURED__
OPENAI_BASE_URL=https://api.openai.com/v1
AICF_PROVIDER_TIMEOUT_SECONDS=120
# These must be set explicitly to model IDs supported by your configured provider/account.
AICF_TEXT_MODEL=__NOT_CONFIGURED__
AICF_IMAGE_MODEL=__NOT_CONFIGURED__
AICF_TTS_MODEL=__NOT_CONFIGURED__
